# Copy values into an ignored .env or supply via your environment; never commit secrets.
HOST_NPM_CONFIG_FILE=/absolute/path/to/existing/npm-user-config
HOST_NPM_CA_FILE=
HOST_NPM_PROXY_ENV_FILE=
DB_PASSWORD_FILE=/absolute/path/to/private/db-password-file
# Optional 32-byte binary key, mode 0600, readable by container UID 1000.
# Back up separately from the database; losing it requires re-entering provider credentials.
AI_SETTINGS_KEY_FILE=
# Optional migration source; leave blank for a managed-only installation.
LEGACY_LIBRARY_HOST_PATH=
# Optional writable host/NAS destination; blank uses the managed named volume.
MANAGED_LIBRARY_HOST_PATH=
PUBLIC_ORIGIN=https://your-private-host.example
COOKIE_SECURE=true
# Client-visible path for the separately writable managed-library volume, if mounted on clients.
MANAGED_CLIENT_MOUNT_PREFIX=
LEGACY_LIBRARY_IGNORED_DIRS=
LEGACY_LIBRARY_ALLOW_EMPTY=false
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# External mode only (with compose.external.yml): a dedicated Print Pantry database.
DATABASE_URL=
# Local, isolated HTTP acceptance only; never enable for NAS/private HTTPS.
ALLOW_INSECURE_HTTP=false
