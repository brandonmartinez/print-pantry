{
  "name": "@print-pantry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --include '../../packages/db/dist/**/*.js' --include '../../packages/contracts/dist/**/*.js' src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "account:create": "node dist/provision.js"
  },
  "dependencies": {
    "@print-pantry/contracts": "0.1.0",
    "@print-pantry/db": "0.1.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
