{
  "name": "@print-pantry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --include '../../packages/db/dist/**/*.js' --include '../../packages/contracts/dist/**/*.js' src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --no-file-parallelism",
    "account:create": "node dist/provision.js",
    "library": "node dist/library-cli.js",
    "account:seed-dev": "tsx src/seed-dev.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.24",
    "@print-pantry/contracts": "0.1.0",
    "@print-pantry/db": "0.1.0",
    "@print-pantry/indexer": "0.1.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.6.2",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.21.0"
  }
}
