# syntax=docker/dockerfile:1.7
FROM node:24.13.1-bookworm-slim AS dependencies
WORKDIR /workspace
RUN chown node:node /workspace
USER node
COPY --chown=node:node package.json package-lock.json .npmrc ./
COPY --chown=node:node packages/contracts/package.json packages/contracts/package.json
COPY --chown=node:node packages/db/package.json packages/db/package.json
COPY --chown=node:node packages/indexer/package.json packages/indexer/package.json
COPY --chown=node:node apps/api/package.json apps/api/package.json
COPY --chown=node:node apps/web/package.json apps/web/package.json
COPY --chown=node:node deploy/npm-ci.sh deploy/npm-ci.sh
RUN --mount=type=secret,id=npmrc,required=true,target=/home/node/.npmrc,uid=1000,gid=1000 \
    --mount=type=secret,id=npm_ca,target=/run/secrets/npm_ca,uid=1000,gid=1000 \
    --mount=type=secret,id=npm_proxy,target=/run/secrets/npm_proxy,uid=1000,gid=1000 \
    sh deploy/npm-ci.sh build

FROM dependencies AS build
COPY --chown=node:node . .
RUN npm run build

FROM node:24.13.1-bookworm-slim AS runtime-dependencies
WORKDIR /workspace
RUN chown node:node /workspace
USER node
COPY --chown=node:node package.json package-lock.json .npmrc ./
COPY --chown=node:node packages/contracts/package.json packages/contracts/package.json
COPY --chown=node:node packages/db/package.json packages/db/package.json
COPY --chown=node:node packages/indexer/package.json packages/indexer/package.json
COPY --chown=node:node apps/api/package.json apps/api/package.json
COPY --chown=node:node apps/web/package.json apps/web/package.json
COPY --chown=node:node deploy/npm-ci.sh deploy/npm-ci.sh
RUN --mount=type=secret,id=npmrc,required=true,target=/home/node/.npmrc,uid=1000,gid=1000 \
    --mount=type=secret,id=npm_ca,target=/run/secrets/npm_ca,uid=1000,gid=1000 \
    --mount=type=secret,id=npm_proxy,target=/run/secrets/npm_proxy,uid=1000,gid=1000 \
    sh deploy/npm-ci.sh runtime

FROM node:24.13.1-bookworm-slim AS api
ENV NODE_ENV=production
WORKDIR /workspace
COPY --from=runtime-dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=runtime-dependencies --chown=node:node /workspace/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=runtime-dependencies --chown=node:node /workspace/packages/db/package.json ./packages/db/package.json
COPY --from=runtime-dependencies --chown=node:node /workspace/packages/indexer/package.json ./packages/indexer/package.json
COPY --from=runtime-dependencies --chown=node:node /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=node:node /workspace/packages/contracts/dist ./packages/contracts/dist
COPY --from=build --chown=node:node /workspace/packages/db/dist ./packages/db/dist
COPY --from=build --chown=node:node /workspace/packages/db/drizzle ./packages/db/drizzle
COPY --from=build --chown=node:node /workspace/packages/indexer/dist ./packages/indexer/dist
COPY --from=build --chown=node:node /workspace/apps/api/dist ./apps/api/dist
COPY --chown=node:node deploy/entrypoint.sh ./deploy/entrypoint.sh
USER node
EXPOSE 3000
ENTRYPOINT ["sh", "deploy/entrypoint.sh"]
CMD ["node", "apps/api/dist/index.js"]

FROM nginxinc/nginx-unprivileged:1.28.2-alpine AS web
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
