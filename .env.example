# Development defaults only. Copy to .env to customize; never commit real credentials.
WEB_PORT=5173
API_PORT=3000
SSH_PORT=2222
SSH_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
# Optional existing absolute host directory for development PostgreSQL 17 data.
# Blank keeps the named Docker volume. An empty folder initializes a fresh DB;
# changing this path does not transfer existing accounts or application data.
DEV_POSTGRES_HOST_PATH=
DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/replace-database
# Absolute path to a host-side public authorized_keys file for SSH access.
SSH_AUTHORIZED_KEYS_FILE=
# Required absolute path to your existing npm user configuration (mounted read-only).
HOST_NPM_CONFIG_FILE=
# Optional absolute path to your host Git config; defaults to $HOME/.gitconfig.
# For XDG configuration, set this to $HOME/.config/git/config instead.
HOST_GIT_CONFIG_FILE=
# Optional absolute paths to an external CA bundle and an untracked proxy env file.
HOST_NPM_CA_FILE=
HOST_NPM_PROXY_ENV_FILE=
# Optional read-only source library, used only for explicit migration indexing/adoption.
# Compose sets LEGACY_LIBRARY_ROOT=/mnt/legacy-library only when this is set.
LEGACY_LIBRARY_HOST_PATH=
# Live managed library host/NAS directory. Blank uses .pantry-data/library in
# development and a named Docker volume in production.
MANAGED_LIBRARY_HOST_PATH=
# API-process paths when running outside Compose; legacy is optional.
# Compose supplies its own in-container paths for all roots.
LEGACY_LIBRARY_ROOT=
# Separate writable roots; never put them inside the legacy source.
# Development defaults to ignored .pantry-data/{intake,library} in the workspace.
# Production Compose uses independent persistent volumes.
IMPORT_STORAGE_ROOT=
MANAGED_LIBRARY_ROOT=
# Optional client-visible managed-library mount; blank disables copy-local-path.
MANAGED_CLIENT_MOUNT_PREFIX=
# Comma-separated directory names to ignore (no blanket underscore filtering).
LEGACY_LIBRARY_IGNORED_DIRS=
# Only enable when a truly emptied mounted library should mark all entries missing.
LEGACY_LIBRARY_ALLOW_EMPTY=false
# Enable behind private HTTPS in production.
COOKIE_SECURE=false
