# Development defaults only. Copy to .env to customize; never commit real credentials.
WEB_PORT=5173
API_PORT=3000
SSH_PORT=2222
SSH_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/replace-database
# Absolute path to a host-side public authorized_keys file for SSH access.
SSH_AUTHORIZED_KEYS_FILE=
# Required absolute path to your existing npm user configuration (mounted read-only).
HOST_NPM_CONFIG_FILE=
# Optional absolute paths to an external CA bundle and an untracked proxy env file.
HOST_NPM_CA_FILE=
HOST_NPM_PROXY_ENV_FILE=
# Optional future read-only library mount; never point this at a real library for tests.
LIBRARY_HOST_PATH=
